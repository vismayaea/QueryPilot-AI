# Google Gemini API Key (Required)
# Generate your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Configured Gemini model (Default: gemini-3.5-flash-lite)
# Supported: gemini-3.5-flash-lite, gemini-3.5-flash, gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Persistent SQLite datasets directory (Optional, defaults to ./data/datasets)
DATASETS_DIR=./data/datasets

# Port configuration (Optional, defaults to 8000)
PORT=8000

# LangSmith Tracing (Optional)
LANGCHAIN_TRACING_V2=false
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=querypilot-ai
