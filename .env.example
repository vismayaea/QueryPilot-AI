# Google Gemini API Key (required)
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Gemini model to use (optional — defaults to gemini-2.0-flash)
# Other options: gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-flash-thinking-exp
GEMINI_MODEL=gemini-2.0-flash

# LangSmith (optional — for tracing and monitoring)
LANGCHAIN_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=text2sql-agent
